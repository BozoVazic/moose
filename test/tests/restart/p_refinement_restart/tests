[Tests]
  design = "Restartable.md DataIO.md"
  [steady_solve]
    type = 'Exodiff'
    input = 'steady.i'
    exodiff = 'steady_out.e'
    requirement = 'The system shall support running and saving off a steady solution with p-refinement for use in a restart.'
    issues = '#30048'
  []

  [steady_from_steady_restart]
    type = 'Exodiff'
    input = 'restarted_steady.i'
    exodiff = 'restarted_steady_out.e'
    prereq = 'steady_solve'
    requirement = 'The system shall support restarting a steady state solve from a steady solution with p-refinement.'
    issues = '#30048'
  []

  [p_refinement_flag_mismatch]
    requirement = 'The system shall restore a variable from a checkpoint in which the same variable was stored with a different p_refinement flag'
    issues = '#30048'
    [write]
      type = RunApp
      input = 'lagrange_p_refinement_true.i'
      detail = 'by writing a checkpoint of a LAGRANGE variable with p_refinement = true'
    []
    [restore]
      type = CSVDiff
      input = 'restart_lagrange_default.i'
      csvdiff = 'restart_lagrange_default_out.csv'
      prereq = 'p_refinement_flag_mismatch/write'
      detail = 'and restoring it into the same variable with the default p_refinement.'
    []
  []

  [p_refinement_size_mismatch]
    type = RunException
    input = 'restarted_steady.i'
    cli_args = 'Variables/u/p_refinement=false'
    expect_err = 'The stored variable has \d+ local degrees of freedom but the variable to restore has \d+'
    prereq = 'steady_solve'
    requirement = 'The system shall report an error when restoring a variable from a p-refined checkpoint into the same variable without p-refinement, because the stored degrees of freedom do not match.'
    issues = '#30048'
  []
[]
